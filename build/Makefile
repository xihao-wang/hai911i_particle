####### Compile

camera.o: ../sources/camera.cpp ../include/camera.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o camera.o ../sources/camera.cpp

openglwindow.o: ../sources/openglwindow.cpp ../include/openglwindow.h \
		../include/camera.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o openglwindow.o ../sources/openglwindow.cpp

systemwindow.o: ../sources/systemwindow.cpp ../include/systemwindow.h \
		../include/openglwindow.h \
		../include/camera.h \
		../include/particle.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o systemwindow.o ../sources/systemwindow.cpp

main.o: ../main.cpp ../include/systemwindow.h \
		../include/openglwindow.h \
		../include/camera.h \
		../include/particle.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../main.cpp

moc_openglwindow.o: moc_openglwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_openglwindow.o moc_openglwindow.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/particules/bin || mkdir -p $(INSTALL_ROOT)/opt/particules/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/particules/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/particules/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/particules/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/particules/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

